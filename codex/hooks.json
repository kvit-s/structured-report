{
  "description": "What's Next — end a working turn with a report and a card of next steps.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$WHATS_NEXT_ROOT/plugins/whats-next/hooks/python.sh\" \"$WHATS_NEXT_ROOT/plugins/whats-next/scripts/report_context.py\" --host codex",
            "statusMessage": "Loading the What's Next convention"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$WHATS_NEXT_ROOT/plugins/whats-next/hooks/python.sh\" \"$WHATS_NEXT_ROOT/plugins/whats-next/scripts/report_record.py\" --host codex"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$WHATS_NEXT_ROOT/plugins/whats-next/hooks/python.sh\" \"$WHATS_NEXT_ROOT/plugins/whats-next/scripts/report_record.py\" --host codex"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$WHATS_NEXT_ROOT/plugins/whats-next/hooks/python.sh\" \"$WHATS_NEXT_ROOT/plugins/whats-next/scripts/report_gate.py\" --host codex",
            "statusMessage": "Checking how the turn ended"
          }
        ]
      }
    ]
  }
}
